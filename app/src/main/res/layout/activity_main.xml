<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="220dp"
            android:layout_height="190dp"
            android:contentDescription="Logo SmartRiego JNJL"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_smartriego" />

        <TextView
            android:id="@+id/tvEquipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Equipo: --"
            android:textColor="@color/sr_texto"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEquipo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar equipo" />

            <Button
                android:id="@+id/btnSalir"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cerrar sesión" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Humedad del suelo"
            android:textColor="@color/sr_texto"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvHumedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- %"
            android:textColor="@color/sr_verde_oscuro"
            android:textSize="56sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbHumedad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/sr_azul_agua"
            android:progressBackgroundTint="@color/sr_gris_borde" />

        <TextView
            android:id="@+id/tvBomba"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Bomba: --"
            android:textColor="@color/sr_texto"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnRegar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Regar ahora" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartHumedad"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>