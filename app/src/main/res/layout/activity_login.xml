<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        tools:context=".LoginActivity">

        <ImageView
            android:layout_width="240dp"
            android:layout_height="208dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Logo SmartRiego JNJL"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_smartriego" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Iniciá sesión con tu cuenta"
            android:textColor="@color/sr_texto"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="32dp"
            android:autofillHints="emailAddress"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:hint="Contraseña"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#C62828" />

        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ingresar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:autoLink="web"
            android:gravity="center"
            android:linksClickable="true"
            android:text="¿No tenés cuenta? Registrate y comprá tu equipo en\nhttps://smart-riego.netlify.app"
            android:textColor="@color/sr_texto"
            android:textColorLink="@color/sr_azul_agua"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>